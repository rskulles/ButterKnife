{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "butterknife",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/ButterKnife",
        "--launch-profile",
        "http"
      ],
      "port": 5175
    },
    {
      "name": "butterknife-fake-llm",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ASPNETCORE_ENVIRONMENT=Development",
        "Llm__Backends__0__BaseUrl=http://127.0.0.1:11434",
        "Llm__Backends__1__BaseUrl=http://127.0.0.1:11434/v1",
        "dotnet",
        "run",
        "--project",
        "src/ButterKnife",
        "--no-launch-profile",
        "--urls",
        "http://localhost:5176"
      ],
      "port": 5176
    },
    {
      "name": "butterknife-lan",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ASPNETCORE_ENVIRONMENT=Development",
        "dotnet",
        "run",
        "--project",
        "src/ButterKnife",
        "--no-launch-profile",
        "--urls",
        "http://0.0.0.0:5175"
      ],
      "port": 5175
    },
    {
      "name": "butterknife-test",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ASPNETCORE_ENVIRONMENT=Development",
        "Database__ConnectionString=Data Source=data/test.db",
        "Llm__Backends__0__BaseUrl=http://127.0.0.1:11434",
        "Llm__Backends__1__BaseUrl=http://127.0.0.1:11434/v1",
        "dotnet",
        "run",
        "--project",
        "src/ButterKnife",
        "--no-launch-profile",
        "--urls",
        "http://localhost:5177"
      ],
      "port": 5177
    }
  ]
}
