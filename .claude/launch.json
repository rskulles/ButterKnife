{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "butterknife",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/ButterKnife", "--launch-profile", "http"],
      "port": 5175
    },
    {
      "name": "butterknife-fake-llm",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ASPNETCORE_ENVIRONMENT=Development",
        "Llm__Backends__0__BaseUrl=http://127.0.0.1:11434",
        "Llm__Backends__1__BaseUrl=http://127.0.0.1:11434/v1",
        "dotnet", "run", "--project", "src/ButterKnife", "--no-launch-profile", "--urls", "http://localhost:5176"
      ],
      "port": 5176
    }
  ]
}
