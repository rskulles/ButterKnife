@* Settings page. The section list lives in SettingsLayout; this picks the section from the route and checks who is
   asking and from where: Account is for everyone, the rest for administrators inside the house (this computer or
   the home network; see LoginGate.NetworkZone). "/connections" is kept so old bookmarks still land on the
   connections section. *@
@page "/settings"
@page "/settings/{Section}"
@page "/connections"
@layout SettingsLayout
@inject NavigationManager Nav
@inject CurrentUser CurrentUser

<PageTitle>@Title · Settings · ButterKnife</PageTitle>

@if (_user is null)
{
    <p class="text-body-secondary">Loading…</p>
}
else
{
    @switch (Current)
    {
        case "account":
            <AccountSettings />
            break;
        case "general" when _canAdminister:
            <GeneralSettings />
            break;
        case "connections" when _canAdminister:
            <ConnectionsSettings />
            break;
        case "personas" when _canAdminister:
            <PersonasSettings />
            break;
        case "users" when _canAdminister:
            <UsersSettings />
            break;
        case "data" when _canAdminister:
            <DataSettings />
            break;
        case "general" or "connections" or "personas" or "users" or "data" when _user.IsAdmin:
            <h1 class="h4">Only from home</h1>
            <p class="text-muted">
                You are an administrator, but @Title can only be changed from inside the house: on the computer running
                ButterKnife or a device on the same network. From here you can chat and change your <a href="settings/account">Account</a>.
            </p>
            break;
        case "general" or "connections" or "personas" or "users" or "data":
            <h1 class="h4">Administrators only</h1>
            <p class="text-muted">Only an administrator can change @Title. Ask whoever runs this ButterKnife, or open <a href="settings/account">Account</a> for your own settings.</p>
            break;
        default:
            <h1 class="h4">Not found</h1>
            <p class="text-muted">There is no "@Section" section. Pick one on the left.</p>
            break;
    }
}

@code {
    [Parameter] public string? Section { get; set; }

    private AppUser? _user;
    private bool _canAdminister;

    protected override async Task OnInitializedAsync()
    {
        _user = await CurrentUser.GetAsync();
        _canAdminister = await CurrentUser.CanAdministerAsync();
    }

    private string Current =>
        Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/').Equals("connections", StringComparison.OrdinalIgnoreCase)
            ? "connections"
            : (Section ?? (_canAdminister ? "general" : "account")).ToLowerInvariant();

    private string Title => Current switch
    {
        "general" => "General",
        "account" => "Account",
        "connections" => "Connections",
        "personas" => "Personas",
        "users" => "Users",
        "data" => "Data",
        _ => "Not found",
    };
}
