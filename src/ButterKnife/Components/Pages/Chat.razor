@page "/"
@page "/chat/{Id:guid}"
@using System.Diagnostics
@using System.Text
@using ButterKnife.Options
@using ButterKnife.Services
@using Microsoft.Extensions.Options

<PageTitle>@(_title is null ? "ButterKnife" : $"{_title} · ButterKnife")</PageTitle>

<div class="chat">
    <header class="chat-toolbar">
        <label class="visually-hidden" for="model-select">Model</label>
        <select id="model-select" class="form-select form-select-sm model-select"
                value="@_selectedKey" @onchange="OnModelChanged" disabled="@_isStreaming">
            @if (_models.Count == 0)
            {
                <option value="">@(_loadingModels ? "Loading models…" : "No models available")</option>
            }
            @foreach (var m in _models)
            {
                <option value="@m.Key">@m</option>
            }
        </select>

        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshModelsAsync" disabled="@(_isStreaming || _loadingModels)" title="Refresh model list" aria-label="Refresh model list">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="NewChat" disabled="@_isStreaming">
            New chat
        </button>
        @if (_conversationId is not null)
        {
            @if (_renamingTitle)
            {
                <span class="delete-confirm" role="group" aria-label="Rename chat">
                    <input class="form-control form-control-sm rename-input" @bind="_renameText" @bind:event="oninput"
                           @onkeydown="OnRenameKeyAsync" aria-label="Chat title" />
                    <button class="btn btn-sm btn-primary" @onclick="RenameConversationAsync" disabled="@string.IsNullOrWhiteSpace(_renameText)">Save</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _renamingTitle = false">Cancel</button>
                </span>
            }
            else if (!_confirmDelete)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="BeginRename" disabled="@_isStreaming"
                        title="Rename this chat" aria-label="Rename this chat">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                </button>
            }
            @if (_confirmDelete)
            {
                <span class="delete-confirm" role="alertdialog" aria-label="Delete this chat?">
                    <span class="small">Delete this chat?</span>
                    <button class="btn btn-sm btn-danger" @onclick="DeleteConversationAsync">Delete</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false">Keep</button>
                </span>
            }
            else if (!_renamingTitle)
            {
                <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true" disabled="@_isStreaming"
                        title="Delete this chat" aria-label="Delete this chat">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
            }
        }
        <label class="visually-hidden" for="persona-select">Persona</label>
        <select id="persona-select" class="form-select form-select-sm persona-select ms-auto"
                value="@_personaKey" @onchange="OnPersonaChangedAsync" disabled="@_isStreaming"
                title="@(SelectedPersona?.Description ?? "No system prompt is sent")">
            <option value="">No persona</option>
            @foreach (var p in _personas)
            {
                <option value="@p.Id">@p.Name@(p.IsBuiltIn ? "" : " (custom)")</option>
            }
        </select>
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showPersonaPrompt = !_showPersonaPrompt"
                disabled="@(SelectedPersona is null)" aria-expanded="@_showPersonaPrompt" aria-controls="persona-prompt"
                title="Show this persona's system prompt">
            @(_showPersonaPrompt ? "Hide prompt" : "Show prompt")
        </button>
    </header>

    @if (_showPersonaPrompt && SelectedPersona is { } persona)
    {
        <div id="persona-prompt" class="persona-prompt">
            <div class="small text-muted mb-1">@persona.Name — @persona.Description</div>
            <div class="persona-prompt-text">@persona.SystemPrompt</div>
        </div>
    }

    @if (Selected is not null || _turns.Count > 0)
    {
        var (used, exact) = CurrentContext();
        var percent = _contextWindow is { } window && window > 0 ? Math.Min(100, used * 100.0 / window) : (double?)null;
        <div class="context-meter" title="@ContextTooltip(used, exact)">
            <div class="progress context-bar" role="progressbar" aria-label="Context used" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@(percent is { } p ? (int)p : 0)">
                <div class="progress-bar @(percent >= 90 ? "bg-danger" : percent >= 70 ? "bg-warning" : "") @(percent is null ? "progress-bar-striped context-unknown" : "")"
                     style="width: @((percent ?? 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
            </div>
            <span class="context-text">
                context @(exact ? "" : "~")@FormatTokens(used) / @(_contextWindow is { } w ? FormatTokens(w) : "?")
                @if (percent is { } pc)
                {
                    <span class="text-muted">&nbsp;· @pc.ToString("0")%</span>
                }
            </span>
            <button class="btn btn-sm btn-outline-secondary btn-compact" @onclick="CompactAsync" disabled="@(!CanCompact)"
                    title="Summarise the older turns so the conversation takes less context. The transcript stays as it is.">
                @(_compacting ? "Compacting…" : "Compact")
            </button>
            @if (_compacting)
            {
                <button class="btn btn-sm btn-link p-0" @onclick="CancelCompaction">Cancel</button>
            }
        </div>
    }

    @foreach (var (backend, message) in _backendErrors)
    {
        <div class="alert alert-warning py-1 px-2 small mb-1" role="alert">
            <strong>@backend</strong> unreachable: @message
        </div>
    }

    <div class="chat-messages" @ref="_messagesElement">
        @if (_turns.Count == 0)
        {
            @if (!_loadingModels && _models.Count == 0 && _backendErrors.Count == 0)
            {
                <p class="chat-empty text-muted">No LLM connections yet. <a href="connections">Add a connection</a> to get started.</p>
            }
            else
            {
                <p class="chat-empty text-muted">Pick a model and say something.</p>
            }
        }
        @for (var i = 0; i < _turns.Count; i++)
        {
            var turn = _turns[i];
            @if (_summaryThrough > 0 && i == _summaryThrough)
            {
                <div class="compact-divider">
                    <button type="button" class="btn btn-link btn-sm p-0 compact-toggle" @onclick="() => _showSummary = !_showSummary">
                        @_summaryThrough earlier message@(_summaryThrough == 1 ? "" : "s") compacted into a summary — @(_showSummary ? "hide" : "show")
                    </button>
                    @if (_showSummary && _summary is not null)
                    {
                        <div class="compact-summary msg-markdown">@((MarkupString)Markdown.ToHtml(_summary))</div>
                    }
                </div>
            }
            <div class="msg msg-@turn.Role.ToString().ToLowerInvariant()">
                <div class="msg-role">@turn.Role</div>
                @if (turn.Role == ChatRole.Assistant)
                {
                    <div class="msg-content msg-markdown">@turn.Html@(turn.IsStreaming ? "▍" : "")</div>
                    @if (turn.IsStreaming)
                    {
                        <ButterKnifeThrobber Stats="turn.GetStats" />
                    }
                    else if (turn.Chunks > 0)
                    {
                        <div class="msg-stats" title="@ButterKnifeThrobber.StatsTooltip">@ButterKnifeThrobber.FormatStats(turn.GetStats())</div>
                    }
                }
                else
                {
                    <div class="msg-content">
                        @if (turn.Images.Count > 0)
                        {
                            <div class="msg-images">
                                @foreach (var image in turn.Images)
                                {
                                    <img src="@image.DataUrl" alt="Attached image"
                                         class="msg-image @(_expandedImages.Contains(image) ? "msg-image-expanded" : "")"
                                         title="Click to toggle size" @onclick="() => ToggleImage(image)" />
                                }
                            </div>
                        }
                        @turn.Text
                    </div>
                }
            </div>
        }
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger py-1 px-2 small mb-1" role="alert">@_error</div>
    }

    <footer class="chat-input">
        <div class="chat-compose">
            @if (_pendingImages.Count > 0)
            {
                <div class="pending-images">
                    @foreach (var image in _pendingImages)
                    {
                        <div class="pending-image">
                            <img src="@image.DataUrl" alt="Pending attachment" />
                            <button type="button" class="pending-remove" title="Remove image" aria-label="Remove image"
                                    @onclick="() => _pendingImages.Remove(image)" disabled="@_isStreaming"><i class="bi bi-x" aria-hidden="true"></i></button>
                        </div>
                    }
                </div>
            }
            @if (_imageError is not null)
            {
                <div class="small text-danger">@_imageError</div>
            }
            @if (_dictationStatus is not null)
            {
                <div class="small @(_dictationError ? "text-danger" : "text-muted")">@_dictationStatus</div>
            }
            <textarea @ref="_inputElement" class="form-control" rows="2"
                      placeholder="@(_pendingImages.Count > 0 ? "Ask about the image… (Enter to send)" : "Message… (Enter to send, Shift+Enter for newline)")"
                      @bind="_input" @bind:event="oninput" disabled="@_isStreaming"></textarea>
        </div>
        <div class="chat-actions">
            <div class="mic-group">
                <button type="button" @ref="_micElement" class="btn btn-mic @(_dictation switch { DictationState.Recording => "btn-danger btn-mic-recording", DictationState.Transcribing => "btn-outline-secondary", _ => "btn-outline-secondary" })"
                        @onclick="ToggleDictationAsync" disabled="@(_isStreaming || _dictation == DictationState.Transcribing)"
                        title="@DictationTitle" aria-label="@DictationTitle" aria-pressed="@(_dictation == DictationState.Recording)">
                    <i class="bi @(_dictation switch { DictationState.Recording => "bi-stop-fill", DictationState.Transcribing => "bi-hourglass-split", _ => "bi-mic-fill" })" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary btn-mic-settings" @onclick="() => _showDictationSettings = !_showDictationSettings"
                        title="Dictation settings" aria-label="Dictation settings" aria-expanded="@_showDictationSettings" disabled="@(_dictation != DictationState.Idle)"><i class="bi bi-gear" aria-hidden="true"></i></button>
                @if (_showDictationSettings)
                {
                    <div class="dictation-settings" role="dialog" aria-label="Dictation settings">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="dict-autostop" checked="@_autoStop" @onchange="e => SaveDictationPrefsAsync(autoStop: (bool)e.Value!)" />
                            <label class="form-check-label" for="dict-autostop">Stop automatically when I pause</label>
                            <div class="form-text">After you start speaking, about @(DictationOptions.Value.SilenceDurationMs / 1000.0)s of quiet ends the recording. Otherwise click ■.</div>
                        </div>
                        <div class="form-check mt-2">
                            <input type="checkbox" class="form-check-input" id="dict-autosend" checked="@_autoSend" @onchange="e => SaveDictationPrefsAsync(autoSend: (bool)e.Value!)" />
                            <label class="form-check-label" for="dict-autosend">Send as soon as it's transcribed</label>
                            <div class="form-text">Off: the text lands in the box for you to check first.</div>
                        </div>
                        <div class="form-text mt-2">Remembered by this browser.</div>
                    </div>
                }
            </div>
            <label class="btn btn-outline-secondary btn-attach @(_isStreaming ? "disabled" : "")" title="Attach images (JPEG, PNG, GIF, WebP)">
                <i class="bi bi-paperclip" aria-hidden="true"></i><span class="visually-hidden">Attach images</span>
                <InputFile OnChange="OnFilesSelectedAsync" multiple accept="image/*" disabled="@_isStreaming" />
            </label>
            @if (_isStreaming)
            {
                <button class="btn btn-danger" @onclick="Stop">Stop</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="SendAsync" disabled="@(!CanSend)">Send</button>
            }
        </div>
    </footer>
</div>
