@* General section (administrators): version and release check, whether the server listens beyond localhost, the
   keyboard shortcuts, and Quit for the bundled app. The network switch is read by Program.cs at startup, so the
   page compares it with what the server is actually bound to and says when a restart is needed. *@
@implements IDisposable
@inject ISettingsStore Settings
@inject SettingsEvents Events
@inject LanAddressService Lan
@inject NavigationManager Nav
@inject IHostApplicationLifetime Lifetime
@inject UpdateChecker Updates

<h1 class="h4">General</h1>
<p class="text-muted">Applies to this ButterKnife as a whole, for everyone who uses it.</p>

<div class="row">
    <div class="col-lg-6">
        @* Version and release check. The check runs only when this section opens (and the switch is on), never in
           the background, and the answer is cached by UpdateChecker for a few hours. *@
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <span class="fw-semibold">ButterKnife @UpdateChecker.CurrentVersion.ToString(3)</span>
            @if (_update is { IsNewer: true } newer)
            {
                <span class="badge text-bg-primary">Update available</span>
                <span>Version @newer.Latest!.ToString(3) is out.</span>
                <a class="btn btn-sm btn-primary" href="@(newer.Url ?? "https://github.com/rskulles/ButterKnife/releases")" target="_blank" rel="noopener">
                    <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Download
                </a>
            }
            else if (_update is { Error: null })
            {
                <span class="text-body-secondary small">You have the latest version.</span>
            }
            else if (_update is { Error: { } error })
            {
                <span class="text-body-secondary small" title="@error">Could not check for a newer version.</span>
            }
            else if (_checking)
            {
                <span class="text-body-secondary small"><span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Checking for a newer version…</span>
            }
        </div>
        <div class="form-check form-switch mb-4">
            <input class="form-check-input" type="checkbox" role="switch" id="check-updates" checked="@_checkForUpdates"
                   @onchange="e => SetCheckForUpdatesAsync((bool)e.Value!)" disabled="@_busy" />
            <label class="form-check-label" for="check-updates">Check for new versions when Settings opens</label>
        </div>
        <div class="form-text mb-4 mt-n3">One request to GitHub for the latest release, at most every few hours. Nothing else is sent.</div>

        <hr class="my-4" />

        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="listen-on-lan" checked="@_listenOnLan"
                   @onchange="e => SetListenOnLanAsync((bool)e.Value!)" disabled="@_busy" />
            <label class="form-check-label" for="listen-on-lan">Reachable from other devices on the local network</label>
        </div>
        <div class="form-text">
            On: ButterKnife listens on every network interface so a phone or another computer on the same Wi‑Fi can open it
            (use "Open on phone" in a chat for a QR code). Everyone who opens it from another device signs in with an
            account from <a href="settings/users">Users</a> and sees only their own chats; set your own password under
            <a href="settings/account">Account</a> to get in as yourself. Off: only this computer can reach it.
        </div>
        <div class="small mt-2" role="status">
            @if (_listenOnLan == _access.ListensOnLan)
            {
                <span class="text-body-secondary">Currently @(_access.ListensOnLan ? "reachable on the local network" : "localhost only").</span>
                @if (_access.ListensOnLan && _access.Urls.Count > 0)
                {
                    <span class="text-body-secondary"> Address for other devices: </span><code class="user-select-all">@_access.Urls[0]</code>
                }
            }
            else
            {
                <span class="text-warning-emphasis"><i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Restart ButterKnife to apply. It is currently @(_access.ListensOnLan ? "reachable on the local network" : "localhost only").</span>
            }
        </div>
        @if (_message is not null)
        {
            <div class="small mt-2 @(_ok ? "text-success" : "text-danger")" role="status">@_message</div>
        }

        <hr class="my-4" />

        <h2 class="h6">Keyboard shortcuts</h2>
        <dl class="row small mb-0">
            <dt class="col-5 col-md-4 fw-normal"><kbd>Enter</kbd></dt><dd class="col-7 col-md-8">Send (<kbd>Shift</kbd>+<kbd>Enter</kbd> for a new line)</dd>
            <dt class="col-5 col-md-4 fw-normal"><kbd>Esc</kbd></dt><dd class="col-7 col-md-8">Stop the reply</dd>
            <dt class="col-5 col-md-4 fw-normal"><kbd>Shift</kbd>+<kbd>Esc</kbd></dt><dd class="col-7 col-md-8">Jump to the message box</dd>
            <dt class="col-5 col-md-4 fw-normal"><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>O</kbd></dt><dd class="col-7 col-md-8">New chat (<kbd>⌘</kbd>+<kbd>Shift</kbd>+<kbd>O</kbd> on a Mac)</dd>
        </dl>

        @if (DesktopLauncher.IsBundled)
        {
            <hr class="my-4" />
            <button type="button" class="btn btn-outline-danger" @onclick="Quit">
                <i class="bi bi-power me-1" aria-hidden="true"></i>Quit ButterKnife
            </button>
            <div class="form-text">Stops the server on this computer. Nothing is lost: chats and settings are saved as you go.</div>
        }
    </div>
</div>

@code {
    private string? _message;
    private bool _ok;
    private bool _busy;

    private bool _listenOnLan;
    private PhoneAccess _access = new(false, []);

    private bool _checkForUpdates = true;
    private bool _checking;
    private UpdateCheck? _update;

    protected override async Task OnInitializedAsync()
    {
        Events.Changed += OnChanged;
        await LoadAsync();
        if (_checkForUpdates)
        {
            _ = CheckForUpdatesAsync();
        }
    }

    private async Task CheckForUpdatesAsync()
    {
        _checking = true;
        try
        {
            _update = await Updates.CheckAsync(CancellationToken.None);
        }
        finally
        {
            _checking = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SetCheckForUpdatesAsync(bool on)
    {
        _busy = true;
        try
        {
            await Settings.SetAsync(SettingKeys.CheckForUpdates, on ? null : "false"); // unset means on
            _checkForUpdates = on;
            if (on && _update is null)
            {
                _ = CheckForUpdatesAsync();
            }
        }
        catch (Exception ex)
        {
            _ok = false;
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadAsync()
    {
        // The root page URL stands in for "the app": only the host and port matter here.
        _access = Lan.ForPage(new Uri(Nav.BaseUri));
        _listenOnLan = await Settings.GetAsync(SettingKeys.ListenOnLan) is { } saved ? saved == "true" : _access.ListensOnLan;
        _checkForUpdates = await Settings.GetAsync(SettingKeys.CheckForUpdates) != "false";
    }

    private async Task SetListenOnLanAsync(bool on)
    {
        _busy = true;
        _message = null;
        try
        {
            await Settings.SetAsync(SettingKeys.ListenOnLan, on ? "true" : "false");
            _listenOnLan = on;
            Events.NotifyChanged();
        }
        catch (Exception ex)
        {
            _ok = false;
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    /// <summary>The published app has no window to close, so Settings offers the way out.</summary>
    private void Quit() => Lifetime.StopApplication();

    public void Dispose() => Events.Changed -= OnChanged;
}
