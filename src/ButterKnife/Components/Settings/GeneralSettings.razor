@* General section: how the user is named in the transcript. Stored app-wide (one SQLite row), so every device sees it. *@
@implements IDisposable
@inject ISettingsStore Settings
@inject SettingsEvents Events

<h1 class="h4">General</h1>
<p class="text-muted">Applies to everyone who opens this ButterKnife, on any device.</p>

<div class="row">
    <div class="col-lg-6">
        <label class="form-label" for="display-name">Your name in chats</label>
        <div class="input-group">
            <input id="display-name" class="form-control" @bind="_name" @bind:event="oninput" @onkeydown="OnKeyDownAsync"
                   maxlength="@SettingKeys.MaxUserDisplayNameLength" placeholder="@SettingKeys.DefaultUserDisplayName"
                   autocomplete="nickname" disabled="@_busy" />
            <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@(_busy || !Dirty)">Save</button>
        </div>
        <div class="form-text">
            Shown above your messages instead of "@SettingKeys.DefaultUserDisplayName". Leave it empty to go back to the default.
        </div>

        <div class="mt-3 small text-uppercase text-body-secondary text-end" aria-label="Preview">@Preview</div>
        <div class="px-3 py-2 rounded-3 bg-body-tertiary text-break text-end mb-3" aria-hidden="true">This is how your messages will be labelled.</div>

        @if (_message is not null)
        {
            <div class="small @(_ok ? "text-success" : "text-danger")" role="status">@_message</div>
        }
    </div>
</div>

@code {
    private string _name = "";
    private string _saved = "";
    private string? _message;
    private bool _ok;
    private bool _busy;

    private bool Dirty => !string.Equals(_name.Trim(), _saved, StringComparison.Ordinal);

    private string Preview => string.IsNullOrWhiteSpace(_name) ? SettingKeys.DefaultUserDisplayName : _name.Trim();

    protected override async Task OnInitializedAsync()
    {
        Events.Changed += OnChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _saved = await Settings.GetAsync(SettingKeys.UserDisplayName) ?? "";
        _name = _saved;
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        if (!Dirty)
        {
            await LoadAsync();
            StateHasChanged();
        }
    });

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (!Dirty || _busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var value = _name.Trim();
            await Settings.SetAsync(SettingKeys.UserDisplayName, value);
            _saved = value;
            _name = value;
            _ok = true;
            _message = value.Length == 0 ? $"Back to \"{SettingKeys.DefaultUserDisplayName}\"." : $"Saved. You'll appear as \"{value}\".";
            Events.NotifyChanged();
        }
        catch (Exception ex)
        {
            _ok = false;
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose() => Events.Changed -= OnChanged;
}
