@using System.ComponentModel.DataAnnotations
@using ButterKnife.Options
@using ButterKnife.Services

<h1 class="h4">Connections</h1>
<p class="text-muted">LLM servers this app can talk to. Pick a preset for a stock endpoint, point it at the right host, and save.</p>

<div class="row g-4">
    <div class="col-lg-7">
        @if (_connections.Count == 0)
        {
            <p class="text-muted">No connections yet. Add one on the right.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr><th>Name</th><th>Kind</th><th>Base URL</th><th>Default model</th><th>Context</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _connections)
                        {
                            <tr class="@(c.Id == _editingId ? "table-active" : "")">
                                <td>
                                    @c.Name
                                    @if (c.HasApiKey)
                                    {
                                        <span class="badge text-bg-secondary ms-1" title="An API key is stored for this connection">key</span>
                                    }
                                </td>
                                <td>@KindLabel(c.Kind)</td>
                                <td class="text-break"><code>@c.BaseUrl</code></td>
                                <td>@(c.DefaultModel ?? "—")</td>
                                <td>@(c.ContextWindow is { } ctx ? $"{ctx:N0}" : "auto")</td>
                                <td class="text-nowrap text-end">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => TestSavedAsync(c)" disabled="@_busy">Test</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => BeginEdit(c)" disabled="@_busy">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(c)" disabled="@_busy">Delete</button>
                                </td>
                            </tr>
                            @if (_testResults.TryGetValue(c.Id, out var result))
                            {
                                <tr>
                                    <td colspan="6" class="small @(result.Ok ? "text-success" : "text-danger")">@result.Message</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">@(_editingId is null ? "Add connection" : "Edit connection")</h2>

                <div class="mb-1 small text-muted">Presets</div>
                <div class="mb-2 d-flex flex-wrap gap-1">
                    @foreach (var preset in ConnectionPresets.All)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ApplyPreset(preset)" disabled="@_busy">@preset.Name</button>
                    }
                </div>
                @if (_presetHint is not null)
                {
                    <p class="small text-muted">@_presetHint</p>
                }

                <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="connection">
                    <DataAnnotationsValidator />

                    <div class="mb-2">
                        <label class="form-label small mb-0" for="c-name">Name</label>
                        <InputText id="c-name" class="form-control form-control-sm" @bind-Value="_form.Name" />
                        <ValidationMessage For="() => _form.Name" class="small text-danger" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small mb-0" for="c-kind">Kind</label>
                        <InputSelect id="c-kind" class="form-select form-select-sm" @bind-Value="_form.Kind">
                            @foreach (var kind in Enum.GetValues<BackendKind>())
                            {
                                <option value="@kind">@KindLabel(kind)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small mb-0" for="c-url">Base URL</label>
                        <InputText id="c-url" class="form-control form-control-sm" @bind-Value="_form.BaseUrl" placeholder="http://host:port" />
                        <ValidationMessage For="() => _form.BaseUrl" class="small text-danger" />
                        <div class="form-text">@UrlHint(_form.Kind)</div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small mb-0" for="c-key">API key <span class="text-muted">(optional for local servers)</span></label>
                        <InputText id="c-key" type="password" class="form-control form-control-sm" @bind-Value="_form.ApiKey" autocomplete="off"
                                   placeholder="@(_editingHasKey ? "Leave blank to keep the stored key" : "")" />
                        @if (_editingHasKey)
                        {
                            <div class="form-check mt-1">
                                <InputCheckbox id="c-clear-key" class="form-check-input" @bind-Value="_form.ClearApiKey" />
                                <label class="form-check-label small" for="c-clear-key">Remove the stored API key</label>
                            </div>
                        }
                    </div>

                    <div class="mb-2">
                        <label class="form-label small mb-0" for="c-ctx">Context window <span class="text-muted">(tokens, optional)</span></label>
                        <InputNumber id="c-ctx" class="form-control form-control-sm" @bind-Value="_form.ContextWindow" placeholder="e.g. 32768" />
                        <div class="form-text">Overrides what the server reports, for the context meter. For Ollama it is also sent as num_ctx on every request.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small mb-0" for="c-model">Default model <span class="text-muted">(optional)</span></label>
                        <InputText id="c-model" class="form-control form-control-sm" @bind-Value="_form.DefaultModel" list="c-model-options" />
                        <datalist id="c-model-options">
                            @foreach (var m in _fetchedModels)
                            {
                                <option value="@m"></option>
                            }
                        </datalist>
                        <div class="form-text">Preselected in the chat model picker. Press Test to fetch the model list.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary" disabled="@_busy">@(_editingId is null ? "Add" : "Save")</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="TestFormAsync" disabled="@_busy">Test</button>
                        @if (_editingId is not null)
                        {
                            <button type="button" class="btn btn-sm btn-link" @onclick="CancelEdit" disabled="@_busy">Cancel</button>
                        }
                    </div>
                </EditForm>

                @if (_formMessage is not null)
                {
                    <div class="small mt-2 @(_formOk ? "text-success" : "text-danger")">@_formMessage</div>
                }
            </div>
        </div>
    </div>
</div>
