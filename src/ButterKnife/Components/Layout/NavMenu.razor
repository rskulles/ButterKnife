@implements IAsyncDisposable
@inject IConversationStore Store
@inject ConversationEvents Events
@inject NavigationManager Nav
@inject IJSRuntime JS

@* The sidebar follows the page colour mode. On phones everything below the brand bar is a collapse; inside it the
   conversation list scrolls and a footer (Settings link, colour-mode toggle) stays pinned at the bottom. *@
<div class="d-flex flex-column flex-grow-1 overflow-hidden">
    <div class="navbar px-3 border-bottom flex-shrink-0" style="min-height: 3.5rem">
        <a class="navbar-brand fw-semibold text-body" href="">ButterKnife</a>
        <button class="navbar-toggler d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-nav"
                aria-controls="sidebar-nav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>

    <div class="collapse d-md-block flex-grow-1" id="sidebar-nav">
        <div class="d-flex flex-column h-100">
            @* Search: every word as a prefix, all required, over message text plus a substring match on titles.
               Typing replaces the list with grouped hits; a hit opens the chat at that message (?m=id). *@
            <div class="px-2 pt-2 position-relative">
                <label class="visually-hidden" for="chat-search">Search chats</label>
                <input id="chat-search" type="search" class="form-control form-control-sm" placeholder="Search chats" autocomplete="off"
                       value="@_query" @oninput="OnQueryInput" @onkeydown="OnQueryKeyDown" />
            </div>
            <nav class="nav nav-pills flex-column flex-nowrap gap-1 p-2 flex-grow-1 overflow-auto">
                @if (Searching)
                {
                    @if (_results is null)
                    {
                        <div class="small text-body-secondary px-2 py-1"><span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Searching…</div>
                    }
                    else if (_results.Count == 0)
                    {
                        <div class="small text-body-secondary px-2 py-1" role="status">Nothing matches "@_query.Trim()".</div>
                    }
                    else
                    {
                        <div class="small text-body-secondary px-2" role="status">@_results.Count match@(_results.Count == 1 ? "" : "es") in @_results.Select(h => h.ConversationId).Distinct().Count() chat@(_results.Select(h => h.ConversationId).Distinct().Count() == 1 ? "" : "s")</div>
                        @foreach (var group in _results.GroupBy(h => h.ConversationId))
                        {
                            <div class="mt-1">
                                <NavLink class="nav-link small text-truncate py-1" href="@($"chat/{group.Key}")" title="@group.First().Title">
                                    <i class="bi bi-chat-left-text me-2" aria-hidden="true"></i>@group.First().Title
                                </NavLink>
                                @foreach (var hit in group.Where(h => h.MessageId is not null))
                                {
                                    <a class="d-block small text-decoration-none text-body ps-4 pe-2 py-1 rounded search-hit" href="@($"chat/{hit.ConversationId}?m={hit.MessageId}")">
                                        <span class="text-body-secondary text-uppercase" style="font-size: 0.7em">@(hit.Role == ChatRole.User ? "you" : "reply")</span>
                                        @Snippet(hit.Snippet)
                                    </a>
                                }
                            </div>
                        }
                    }
                }
                else
                {
                <NavLink class="nav-link text-nowrap" href="" Match="NavLinkMatch.All" title="New chat (Ctrl+Shift+O, ⌘⇧O on a Mac)">
                    <i class="bi bi-plus-square-fill me-2" aria-hidden="true"></i>New chat
                </NavLink>

                @foreach (var c in _conversations.Where(c => !c.Archived))
                {
                    @Row(c)
                }
                @if (_conversations.Any(c => c.Archived))
                {
                    <button type="button" class="btn btn-sm btn-link text-body-secondary text-decoration-none text-start px-2 mt-1"
                            @onclick="() => _showArchived = !_showArchived" aria-expanded="@_showArchived" aria-controls="archived-chats">
                        <i class="bi bi-archive me-2" aria-hidden="true"></i>Archived (@_conversations.Count(c => c.Archived))
                        <i class="bi @(_showArchived ? "bi-chevron-up" : "bi-chevron-down") ms-1" aria-hidden="true"></i>
                    </button>
                    @if (_showArchived)
                    {
                        <div id="archived-chats" class="d-flex flex-column gap-1">
                            @foreach (var c in _conversations.Where(c => c.Archived))
                            {
                                @Row(c)
                            }
                        </div>
                    }
                }
                @if (_renameError is not null)
                {
                    <div class="px-2 small text-warning">@_renameError</div>
                }
                }
            </nav>

            @* pb-3 matches the article's bottom padding so these buttons line up with the composer's button row. *@
            <div class="d-flex align-items-center justify-content-between gap-2 px-2 pt-2 pb-3 border-top flex-shrink-0">
                <nav class="nav nav-pills">
                    <NavLink class="nav-link text-nowrap px-2 py-1" href="settings" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-gear me-2" aria-hidden="true"></i>Settings
                    </NavLink>
                </nav>
                <div class="flex-shrink-0"><ThemeToggle /></div>
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<ConversationSummary> _conversations = [];
    private Guid? _pendingDelete;
    private Guid? _renaming;
    private string _renameText = "";
    private string? _renameError;
    private bool _showArchived;

    private string _query = "";
    private IReadOnlyList<SearchHit>? _results;
    private CancellationTokenSource? _searchCts;

    private bool Searching => _query.Trim().Length >= 2;

    /// <summary>A snippet from the store with its match markers turned into &lt;mark&gt;; everything else stays text.</summary>
    private static RenderFragment Snippet(string snippet) => builder =>
    {
        var seq = 0;
        var marked = false;
        foreach (var part in snippet.Split([SearchHit.MarkStart, SearchHit.MarkEnd]))
        {
            if (marked)
            {
                builder.OpenElement(seq++, "mark");
                builder.AddContent(seq++, part);
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(seq++, part);
            }
            marked = !marked;
        }
    };

    /// <summary>Debounced: the search runs a short moment after the last keystroke, and a newer keystroke cancels an older run.</summary>
    private async Task OnQueryInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        _results = null;
        if (!Searching)
        {
            return;
        }

        try
        {
            await Task.Delay(250, token);
            var hits = await Store.SearchAsync(_query, cancellationToken: token);
            if (!token.IsCancellationRequested)
            {
                _results = hits;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _results = [];
            _renameError = $"Search failed: {ex.Message}";
        }
    }

    private void OnQueryKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _searchCts?.Cancel();
            _query = "";
            _results = null;
        }
    }

    /// <summary>
    /// One sidebar row: the link, or the inline delete confirmation / rename box, plus an actions menu. The menu is
    /// a Bootstrap dropdown positioned "fixed" so the scrolling list does not clip it. Archived rows are dimmed.
    /// </summary>
    private RenderFragment<ConversationSummary> Row => c =>
        @<div class="d-flex align-items-center @(c.Archived ? "opacity-75" : "")">
            @if (_pendingDelete == c.Id)
            {
                <span class="d-flex align-items-center gap-2 w-100 px-2 small" role="alertdialog" aria-label="Delete this chat?">
                    <span class="flex-grow-1">Delete?</span>
                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(c.Id)">Delete</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelDelete">Keep</button>
                </span>
            }
            else if (_renaming == c.Id)
            {
                <span class="d-flex align-items-center gap-2 w-100 px-2" role="group" aria-label="Rename chat">
                    <input class="form-control form-control-sm" @bind="_renameText" @bind:event="oninput"
                           @onkeydown="e => OnRenameKeyAsync(e, c.Id)" aria-label="Chat title" />
                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => RenameAsync(c.Id)" disabled="@string.IsNullOrWhiteSpace(_renameText)">Save</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelRename">Cancel</button>
                </span>
            }
            else
            {
                <NavLink class="nav-link flex-grow-1 text-truncate small" href="@($"chat/{c.Id}")" title="@c.Title">
                    <i class="bi @(c.Pinned ? "bi-pin-angle-fill" : c.Archived ? "bi-archive" : "bi-chat-left-text") me-2" aria-hidden="true"></i>@c.Title
                </NavLink>
                <div class="dropdown">
                    <button type="button" class="btn btn-sm btn-link text-body-secondary p-1" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}'
                            aria-expanded="false" title="Chat actions" aria-label="Actions for @c.Title">
                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow small">
                        <li><button type="button" class="dropdown-item" @onclick="() => SetPinnedAsync(c, !c.Pinned)"><i class="bi @(c.Pinned ? "bi-pin-angle" : "bi-pin-angle-fill") me-2" aria-hidden="true"></i>@(c.Pinned ? "Unpin" : "Pin to top")</button></li>
                        <li><button type="button" class="dropdown-item" @onclick="() => BeginRename(c)"><i class="bi bi-pencil me-2" aria-hidden="true"></i>Rename</button></li>
                        <li><button type="button" class="dropdown-item" @onclick="() => SetArchivedAsync(c, !c.Archived)"><i class="bi @(c.Archived ? "bi-box-arrow-up" : "bi-archive") me-2" aria-hidden="true"></i>@(c.Archived ? "Unarchive" : "Archive")</button></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><button type="button" class="dropdown-item text-danger" @onclick="() => _pendingDelete = c.Id"><i class="bi bi-trash me-2" aria-hidden="true"></i>Delete</button></li>
                    </ul>
                </div>
            }
        </div>;

    private IJSObjectReference? _js;

    protected override async Task OnInitializedAsync()
    {
        Events.Changed += OnConversationsChanged;
        Nav.LocationChanged += OnLocationChanged;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _js = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Layout/NavMenu.razor.js");
        }
    }

    /// <summary>On phones the list is a collapse; fold it away once a link has navigated.</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            if (_js is not null)
            {
                try
                {
                    await _js.InvokeVoidAsync("closeSidebar");
                }
                catch (JSDisconnectedException)
                {
                }
            }
        });

    private async Task LoadAsync()
    {
        try
        {
            _conversations = await Store.ListAsync();
        }
        catch
        {
            _conversations = [];
        }
    }

    private void OnConversationsChanged() =>
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });

    private void CancelDelete() => _pendingDelete = null;

    private async Task SetPinnedAsync(ConversationSummary c, bool pinned)
    {
        try
        {
            await Store.SetPinnedAsync(c.Id, pinned);
            Events.NotifyChanged();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _renameError = ex.Message;
        }
    }

    private async Task SetArchivedAsync(ConversationSummary c, bool archived)
    {
        try
        {
            await Store.SetArchivedAsync(c.Id, archived);
            if (archived)
            {
                _showArchived = false; // it went into the folded section; unfolding it on every archive would be noisy
            }
            Events.NotifyChanged();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _renameError = ex.Message;
        }
    }

    private void BeginRename(ConversationSummary c)
    {
        _pendingDelete = null;
        _renaming = c.Id;
        _renameText = c.Title;
        _renameError = null;
    }

    private void CancelRename() => _renaming = null;

    private async Task OnRenameKeyAsync(KeyboardEventArgs e, Guid id)
    {
        if (e.Key == "Enter")
        {
            await RenameAsync(id);
        }
        else if (e.Key == "Escape")
        {
            CancelRename();
        }
    }

    private async Task RenameAsync(Guid id)
    {
        if (string.IsNullOrWhiteSpace(_renameText))
        {
            return;
        }

        try
        {
            await Store.SetTitleAsync(id, _renameText);
            _renaming = null;
            Events.NotifyChanged();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _renameError = ex.Message;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        _pendingDelete = null;
        await Store.DeleteAsync(id);
        Events.NotifyChanged();

        var current = Nav.ToBaseRelativePath(Nav.Uri);
        if (current.Equals($"chat/{id}", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/");
        }
    }

    public async ValueTask DisposeAsync()
    {
        Events.Changed -= OnConversationsChanged;
        Nav.LocationChanged -= OnLocationChanged;
        if (_js is not null)
        {
            try
            {
                await _js.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
