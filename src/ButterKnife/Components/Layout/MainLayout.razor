@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        @* flex-grow + overflow-auto: pages taller than the viewport scroll here; the chat page fills it instead. *@
        <article class="content px-4 pb-3 d-flex flex-column flex-grow-1 overflow-auto">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
