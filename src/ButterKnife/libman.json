{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "defaultDestination": "wwwroot/lib",
  "libraries": [
    {
      "library": "bootstrap@5.3.8",
      "destination": "wwwroot/lib/bootstrap/dist",
      "files": [
        "js/bootstrap.bundle.min.js",
        "js/bootstrap.bundle.min.js.map"
      ]
    },
    {
      "library": "bootstrap-icons@1.11.3",
      "destination": "wwwroot/lib/bootstrap-icons",
      "files": [
        "font/bootstrap-icons.min.css",
        "font/fonts/bootstrap-icons.woff2",
        "font/fonts/bootstrap-icons.woff"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "@fontsource/nunito@5.3.0",
      "destination": "wwwroot/lib/nunito",
      "files": [
        "latin-400.css",
        "latin-600.css",
        "latin-700.css",
        "latin-ext-400.css",
        "latin-ext-600.css",
        "latin-ext-700.css",
        "files/nunito-latin-400-normal.woff2",
        "files/nunito-latin-600-normal.woff2",
        "files/nunito-latin-700-normal.woff2",
        "files/nunito-latin-ext-400-normal.woff2",
        "files/nunito-latin-ext-600-normal.woff2",
        "files/nunito-latin-ext-700-normal.woff2"
      ]
    }
  ]
}